# Shared coverage config for the test project (run from the repo root via
# `uv run --project tests`). relative_files makes coverage record
# repo-rooted paths, which Codecov needs to map files to the repository tree.
# source + include_namespace_packages also report files no test imports.
[run]
relative_files = true
source = .
# Measure the Python interpreters tests start, such as the stdio-silencing
# probe; their data is combined into the report.
patch = subprocess

[report]
include_namespace_packages = true
# Filtered here rather than at measurement so the combined data is filtered too.
omit =
    tests/*
    **/.venv/*
    **/.pixi/*
    docs/*
# Entry points run by the container or the launcher are not reachable from the suite.
exclude_also =
    if __name__ == .__main__.:
