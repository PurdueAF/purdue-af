{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/opt/purdue-af/agents/platform-context.md"],
  "skills": ["/opt/purdue-af/skills"],
  "permission": {
    "edit": "ask",
    "bash": "ask"
