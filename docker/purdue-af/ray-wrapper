#!/usr/bin/env bash
# The `ray` on a session's PATH: the Ray CLI, which uv runs from an environment
# of its own. With AF_RAY_ENV set to a pixi project or an environment prefix,
# the Ray cluster a `ray job` call starts runs in that environment
# (apps/ray-train).
set -euo pipefail

RAY_VERSION="2.58.0"
# KubeRay probes a cluster's /api/healthz, which Ray serves from 2.53 on.
MIN_ENV_RAY="2.53"

if [[ -n "${AF_RAY_ENV:-}" ]]; then
  env_dir="$AF_RAY_ENV"
  if [[ -f "$env_dir/pixi.toml" || -f "$env_dir/pyproject.toml" ]]; then
    env_dir="$env_dir/.pixi/envs/default"
  fi
  # Physical path: the Ray cluster mounts /work, not the ~/work symlink to it.
  if ! env_dir="$(cd -P "$env_dir" 2>/dev/null && pwd)"; then
    echo "Error: AF_RAY_ENV=${AF_RAY_ENV} names no environment; for a pixi project, run \`pixi install\` in it first." >&2
    exit 1
  fi
  shopt -s nullglob
  dists=("$env_dir"/lib/python3*/site-packages/ray-*.dist-info)
  if (( ${#dists[@]} == 0 )); then
    echo "Error: ${env_dir} has no Ray; add it, for example with: pixi add --pypi \"ray[default,train]\"" >&2
    exit 1
  fi
  env_ray="${dists[0]##*/ray-}"
  env_ray="${env_ray%.dist-info}"
  IFS=. read -r major minor _ <<< "$env_ray"
  IFS=. read -r min_major min_minor <<< "$MIN_ENV_RAY"
  if (( major < min_major || (major == min_major && minor < min_minor) )); then
    echo "Error: ${env_dir} has Ray ${env_ray}; a Ray cluster needs ${MIN_ENV_RAY} or later." >&2
    exit 1
  fi
  if [[ "$env_dir" == *[\"\\]* ]]; then
    echo "Error: ${env_dir} contains a quote or a backslash, which cannot be passed on." >&2
    exit 1
  fi
  # The gateway forwards no other header, so nothing else is lost.
  export RAY_JOB_HEADERS="{\"X-AF-Ray-Env\": \"${env_dir}\"}"
fi

exec uvx --from "ray[default]==${RAY_VERSION}" ray "$@"
