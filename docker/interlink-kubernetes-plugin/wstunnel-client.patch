+
+    def _add_wstunnel_client_sidecar(self, pod_spec: k.V1PodSpec, client_cmd: str, image: str) -> None:
+        """Run the virtual kubelet's wstunnel client command beside the pod, unprivileged."""
+        sidecar = k.V1Container(
+            name="wstunnel-client",
+            image=image,
+            command=["/bin/sh", "-c"],
+            args=[client_cmd],
+            restart_policy="Always",
+            resources=k.V1ResourceRequirements(
+                requests={"cpu": "100m", "memory": "128Mi"}, limits={"cpu": "100m", "memory": "128Mi"}
+            ),
+            security_context=k.V1SecurityContext(
+                allow_privilege_escalation=False, capabilities=k.V1Capabilities(drop=["ALL"])
+            ),
+        )
+        if not pod_spec.init_containers:
+            pod_spec.init_containers = []
+        pod_spec.init_containers.append(sidecar)
 
