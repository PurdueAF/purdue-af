// Renovate configuration — automated dependency update PRs.
//
// Activation: install the Mend Renovate GitHub App on this repository
// (https://github.com/apps/renovate). The app reads this file from main.
//
// Cluster Kubernetes version: 1.29.x (Geddes). When upgrading the cluster,
// review Helm chart kubeVersion constraints before relaxing packageRules below.
//
// Covers:
//   - Flux HelmRelease chart versions (apps/**) via the flux manager
//   - Dockerfile base images (FROM tags)
//   - GitHub Actions versions (+ pins them to commit SHAs)
//   - Python deps (docker/agentic-interface/pyproject.toml + uv.lock) via the uv manager
//   - pixi manifests (pixi/{base,global}/pixi.toml) — NOT lockfiles
//   - pre-commit hook versions
//
// Pixi lockfiles: Renovate only bumps pixi.toml. CI (ci-pixi-base.yml /
// ci-pixi-global.yml) regenerates pixi.lock when out of sync, runs check-env,
// and on success commits the lock back to the PR branch. That keeps Mend
// runners free of `pixi lock` (which OOMs / fills disk on the science stack)
// while still landing green PRs.
//
// ── tensorflow is the anchor of pixi/global ──────────────────────────────
// conda-forge tensorflow is the slowest-moving package in the science stack,
// and several pins below exist ONLY to keep it solvable. Today (2026-07) it
// is pinned to ==2.19.1 (cuda*) in pixi/global/pixi.toml and it dictates:
//   - python  <3.13  — no conda-forge tensorflow builds for 3.13/3.14 exist
//   - pytorch <2.13  — libtorch 2.13 wants libprotobuf 7; tensorflow 2.19.1
//                      is built against libprotobuf 6 (see rule below)
// IF TENSORFLOW IS EVER DROPPED FROM pixi/global (or upgraded past 2.19.x),
// revisit EVERY pin in packageRules before assuming it is still needed —
// most of them are downstream of tensorflow, not independently motivated.
// Lift them one at a time and let pixi/check-env.py in CI gate the result.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    // Pin `uses:` action refs to immutable commit SHAs (tag kept as comment).
    'helpers:pinGitHubActionDigests',
  ],
  // Batch update PRs into a weekly window to keep noise down.
  schedule: ['before 6am on monday'],
  timezone: 'America/Indiana/Indianapolis',
  labels: ['dependencies'],

  prConcurrentLimit: 2,
  branchConcurrentLimit: 2,

  // Pixi CLI is frozen at 0.62.2 (lock format v6). Newer pixi writes v7,
  // which 0.62.2 cannot read — keep in sync across:
  //   - constraints.pixi (here)
  //   - pixi-version in .github/workflows/ci-pixi-{base,global}.yml
  //   - ARG PIXI_VERSION in docker/purdue-af{,-old}/Dockerfile
  // packageRules below disable bumps; customManagers track the Docker ARG.
  constraints: {
    pixi: '0.62.2',
  },

  ignorePaths: [
    'docker/dask-gateway-server/**', // vendored fork — tracked upstream, do not churn
  ],

  // Flux manager is opt-in by path: parse everything Flux reconciles.
  flux: {
    managerFilePatterns: ['/(^|/)apps/.*\\.ya?ml$/', '/(^|/)deploy/.*\\.ya?ml$/'],
  },

  'pre-commit': {
    enabled: true,
  },

  // Track Dockerfile PIXI_VERSION pins (github-actions already sees
  // pixi-version: in ci-pixi-*.yml; constraints.pixi is a tool-constraint).
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG PIXI_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'prefix-dev/pixi',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // Coding-agent CLIs baked into the AF image. Pinned as Dockerfile ARGs
      // (npm install -g <pkg>@<version>), so only a regex manager sees them.
      // The matching code-server extensions are pinned in
      // docker/purdue-af/scripts/config-extensions.sh and come from Open VSX,
      // which Renovate cannot query — bump those by hand alongside these.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        'ARG CLAUDE_CODE_VERSION="(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'npm',
      depNameTemplate: '@anthropic-ai/claude-code',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG CODEX_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@openai/codex',
    },
  ],

  packageRules: [
    {
      // Private cluster registry — Renovate has no credentials for it and the
      // images are built in-repo anyway (CI builds).
      matchDatasources: ['docker'],
      matchPackageNames: ['geddes-registry.rcac.purdue.edu/**'],
      enabled: false,
    },
    {
      // Freeze pixi CLI at 0.62.2: constraints.pixi, setup-pixi pixi-version,
      // and Dockerfile ARG PIXI_VERSION. Lock format v6 only.
      matchPackageNames: ['pixi', 'prefix-dev/pixi'],
      enabled: false,
    },
    {
      // Group all GitHub Actions bumps into one PR.
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
    },
    {
      // Helm chart bumps stay individual PRs (each needs real review),
      // but label them for triage.
      matchManagers: ['flux'],
      addLabels: ['helm'],
    },
    {
      // Major chart/image bumps: extra label so they stand out.
      matchUpdateTypes: ['major'],
      addLabels: ['major'],
    },
    {
      // dask-gateway >=2025.4.0 requires kubeVersion >=1.30; cluster is on
      // 1.29. Hold at 2024.1.0 until the cluster is upgraded to 1.30+.
      matchManagers: ['flux'],
      matchPackageNames: ['dask-gateway'],
      allowedVersions: '<2025.4.0',
    },
    {
      // Manifest-only: CI regenerates pixi.lock (see ci-pixi-*.yml). Skipping
      // artifacts here is what keeps Mend runners from running `pixi lock`.
      matchManagers: ['pixi'],
      skipArtifactsUpdate: true,
      addLabels: ['pixi'],
    },
    {
      // One PR for the AF base env so co-dependent pins bump together
      // (e.g. jupyterlab needing a matching jupyter_server).
      matchManagers: ['pixi'],
      matchFileNames: ['pixi/base/**'],
      groupName: 'pixi-base',
    },
    {
      matchManagers: ['pixi'],
      matchFileNames: ['pixi/global/**'],
      groupName: 'pixi-global',
    },
    {
      // Stable releases only — no a/b/rc.
      matchFileNames: ['pixi/base/pixi.toml', 'pixi/global/pixi.toml'],
      allowedVersions: '!/(a|b|rc)\\d*$/',
    },
    {
      // openssh uses upstream's "portable" versioning (9.8p1, 10.4p1 — all
      // STABLE releases; pN is the portable-line number, not a pre-release).
      // That's not valid pep440, so without this rule the pixi manager can't
      // parse it and silently never proposes openssh updates. Map the scheme
      // so openssh is Renovate-managed like everything else.
      matchPackageNames: ['openssh'],
      matchDatasources: ['conda'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)p(?<patch>\\d+)$',
    },
    {
      // code-server has never supported nodejs >=23 (every conda-forge build
      // pins nodejs >=22,<23) — a nodejs major bump can never solve together
      // with code-server. Blocks the doomed proposal (seen in PR #90).
      // Relax if code-server upstream ever moves off the 22.x pin.
      matchPackageNames: ['nodejs'],
      matchFileNames: ['pixi/base/pixi.toml'],
      allowedVersions: '<23',
    },
    {
      // opentelemetry-api ==1.41.1 (pixi/base pypi deps) requires
      // importlib-metadata <8.8 — Renovate widening the conda range past it
      // makes the env unsolvable (seen in PR #90). Bump together with the
      // opentelemetry pins, then relax.
      matchPackageNames: ['importlib-metadata'],
      matchFileNames: ['pixi/base/pixi.toml'],
      allowedVersions: '<8.8',
    },
    {
      // pytorch 2.13 -> libtorch 2.13 requires libprotobuf >=7.35.1, which
      // nothing else in pixi/global can accept (seen in PR #96):
      //   - tensorflow 2.19.1 is built against libprotobuf ==6.31.1 on every
      //     linux-64 build except _205/_255, and 2.19.1 is the newest version
      //     conda-forge has — no protobuf-7 tensorflow exists at any version.
      //   - mlflow >=3 caps protobuf <7 on every conda-forge build up to
      //     3.14.0. (Stale: upstream mlflow-skinny allows protobuf <8 since
      //     >=3.11.1; the bound is hardcoded in the feedstock's meta.yaml.)
      // Relax when conda-forge ships a tensorflow built against libprotobuf 7
      // AND the mlflow feedstock syncs its bound to upstream's <8. See the
      // tensorflow-anchor note at the top of this file.
      matchPackageNames: ['pytorch'],
      matchFileNames: ['pixi/global/pixi.toml'],
      allowedVersions: '<2.13',
    },
    {
      // xrootd is capped below 6.x in BOTH pixi manifests (2026-07). The 6.0
      // packaging split moved the Python bindings out of the `xrootd` package
      // into `python-xrootd`: conda-forge ships no py312 build of `xrootd` 6.x
      // at all, so an automated bump would silently drop the `XRootD` module
      // that rucio-clients and fsspec-xrootd import, while xrdcp kept working.
      // 6.0 also breaks callers: glob/iglob default to raise_error=true,
      // `xrdcp --allow-http` is gone, the Davix XrdClHttp plugin is removed,
      // and XrdEc is deprecated.
      // 5.9.x is NOT stale — it is maintained in parallel with 6.x (5.9.6 and
      // 6.1.0 shipped the same day), so patch bumps stay allowed.
      // To lift: move pixi/base AND pixi/global together, add `python-xrootd`
      // explicitly, and confirm `import XRootD` plus fsspec-xrootd still work
      // (pixi/check-env.py gates the import).
      matchPackageNames: ['xrootd', 'python-xrootd', 'libxrootd'],
      matchDatasources: ['conda'],
      allowedVersions: '<6',
    },
    {
      // Python is deliberately frozen at 3.12 platform-wide (2026-07): the
      // science stack is capped by conda-forge tensorflow (no 3.13/3.14
      // builds exist), and the infra images/tests follow so there is ONE
      // python everywhere. Covers the docker manager (FROM python:3.12-slim)
      // and the pixi manager (python = "3.12.*" in pixi/{base,global}).
      // 3.12.x patch releases stay allowed. Relax when conda-forge ships
      // tensorflow for newer python (check: pixi/check-env.py will gate it).
      matchPackageNames: ['python'],
      matchDatasources: ['docker', 'conda'],
      allowedVersions: '<3.13',
    },
  ],
}
