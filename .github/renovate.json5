// Renovate configuration, read from main by the Mend Renovate GitHub App
// (https://github.com/apps/renovate).
//
// KUBE_VERSION in .github/workflows/validate-manifests.sh is the cluster's
// Kubernetes version; relax the rules that name it when it moves.
//
// Covers:
//   - Flux HelmRelease chart versions (apps/**) via the flux manager
//   - Container images in chart values (helm-values) and in plain manifests
//     under apps/ (kubernetes), looked up through registryAliases when they
//     are pulled through the cluster registry's Docker Hub cache
//   - Dockerfile base images (FROM tags)
//   - GitHub Actions versions (+ pins them to commit SHAs)
//   - Python deps and their uv.lock files via pep621
//   - pixi manifests (pixi/{base,global}/pixi.toml) — NOT lockfiles
//   - pre-commit hook versions
//   - `# renovate:` comments on `*_VERSION` pins: Dockerfile ARGs (pixi CLI,
//     coding-agent CLIs, ACP adapters) and workflow env vars (tool pins)
//   - regex managers: the wstunnel pins in interLink values, the
//     integration-challenge revision, `name:`/`tag:` image pairs in chart
//     values, the hadolint hook image, the kubectl the userlist sync downloads
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Pin `uses:` action refs to immutable commit SHAs (tag kept as comment).
    'helpers:pinGitHubActionDigests',
    // `# renovate: datasource=… depName=…` above a `*_VERSION` workflow env var or Dockerfile ARG.
    'customManagers:githubActionsVersions',
    'customManagers:dockerfileVersions',
  ],
  // Batch update PRs into a weekly window to keep noise down.
  schedule: ['before 6am on monday'],
  timezone: 'America/Indiana/Indianapolis',
  labels: ['dependencies'],

  // Every dependency is grouped: packageRules name one group per artifact,
  // and this default takes whatever no rule matches.
  groupName: 'other dependencies',

  prConcurrentLimit: 2,

  // ci-pixi-*.yml pushes the regenerated pixi.lock as this bot; without this
  // Renovate treats the branch as hand-edited and never merges it.
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],

  // Empty, not absent: `config:recommended` skips `**/tests/**`, which holds the
  // integration-challenge pin and the test suite's own dependencies.
  ignorePaths: [],

  // Flux manager is opt-in by path: parse everything Flux reconciles.
  flux: {
    managerFilePatterns: ['/(^|/)apps/.*\\.ya?ml$/', '/(^|/)flux/.*\\.ya?ml$/'],
  },

  // Images in plain manifests; this manager matches no file by default.
  kubernetes: {
    managerFilePatterns: ['/(^|/)apps/.*\\.ya?ml$/'],
  },

  // The cluster registry's pull-through cache of Docker Hub: look the image
  // up upstream, keep the cache hostname in the manifest.
  registryAliases: {
    'geddes2-registry.rcac.purdue.edu/dockerhub-proxy-cache': 'docker.io',
  },

  'pre-commit': {
    enabled: true,
  },

  // `>=` ranges never change, so uv.lock moves only through these: an in-range
  // release of a direct dependency, and a weekly refresh of the transitive pins.
  pep621: {
    rangeStrategy: 'update-lockfile',
    lockFileMaintenance: {
      enabled: true,
    },
  },

  customManagers: [
    {
      // wstunnel in an interLink node's INI config, its shadow template and
      // Hammer's tunnel command: strings to the helm-values manager.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)apps/interlink/.*\\.ya?ml$/'],
      matchStrings: [
        'client_image=ghcr\\.io/erebe/wstunnel:(?<currentValue>\\S+)',
        '\\n\\s+image: ghcr\\.io/erebe/wstunnel:(?<currentValue>\\S+)',
        'WSTUNNEL_TAG=(?<currentValue>v[^\\s&]+)',
      ],
      depNameTemplate: 'ghcr.io/erebe/wstunnel',
      datasourceTemplate: 'docker',
    },
    {
      // The kubectl the userlist sync downloads.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)apps/jupyterhub/userlist-sync/sync-userlist\\.sh$/'],
      matchStrings: ['KUBECTL_VERSION=(?<currentValue>v\\S+)'],
      depNameTemplate: 'kubernetes/kubernetes',
      datasourceTemplate: 'github-releases',
    },
    {
      // The matplotlib the users-graph CronJob installs.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)apps/af-utils/af-users-graph/cronjob\\.yaml$/'],
      matchStrings: ['matplotlib==(?<currentValue>\\S+)'],
      depNameTemplate: 'matplotlib',
      datasourceTemplate: 'pypi',
    },
    {
      // The IRIS-HEP integration challenge revision (tests/integration_challenge/upstream.pin).
      customType: 'regex',
      managerFilePatterns: ['/(^|/)upstream\\.pin$/'],
      matchStrings: ['ref=(?<currentDigest>[0-9a-f]{40})'],
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
      depNameTemplate: 'https://github.com/iris-hep/integration-challenge',
    },
    {
      // Charts that take an image as `name:` + `tag:` (dask-gateway,
      // jupyterhub); helm-values only reads `repository:` + `tag:`.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)apps/.*/values\\.ya?ml$/'],
      matchStrings: [
        'name: "?(?<depName>(?:ghcr|quay|docker|nvcr)\\.io/[\\w./-]+)"?\\n\\s+tag: "?(?<currentValue>[\\w.-]+)"?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // The same pairs behind the Docker Hub cache; a regex manager does not
      // apply registryAliases.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)apps/.*/values\\.ya?ml$/'],
      matchStrings: [
        'name: "?geddes2-registry\\.rcac\\.purdue\\.edu/dockerhub-proxy-cache/(?<image>[\\w./-]+)"?\\n\\s+tag: "?(?<currentValue>[\\w.-]+)"?',
      ],
      datasourceTemplate: 'docker',
      depNameTemplate: 'docker.io/{{{image}}}',
    },
    {
      // The hadolint hook runs this image; the pre-commit manager bumps only `rev`.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)\\.pre-commit-config\\.yaml$/'],
      matchStrings: ['entry: (?<depName>ghcr\\.io/hadolint/hadolint):(?<currentValue>\\S+)'],
      datasourceTemplate: 'docker',
    },
  ],

  packageRules: [
    {
      // geddes2-registry's own projects: see docker/REGISTRY.md. The Docker Hub
      // cache's images are renamed by registryAliases and do not match.
      matchDatasources: ['docker'],
      matchPackageNames: ['geddes2-registry.rcac.purdue.edu/**'],
      enabled: false,
    },
    {
      // The base of docker/interlink-kubernetes-plugin: its tag is locked to
      // PLUGIN_REF and the values pin, and a bump must re-verify the patch applies.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/mginfn/interlink-kubernetes-plugin'],
      enabled: false,
    },
    {
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      automerge: true,
    },
    // Groups: one PR per artifact CI builds or validates, so a cycle rebuilds
    // each image once. A dependency pinned in two artifacts splits by file; one
    // merged by hand holds its artifact's PR for review.
    {
      // Actions, pre-commit hooks, workflow tool pins, the test suite's own dependencies.
      matchFileNames: ['.github/**', '.pre-commit-config.yaml', 'tests/pyproject.toml'],
      groupName: 'ci-tooling',
    },
    {
      // Chart versions and the image tags in their values.
      matchFileNames: ['apps/**', 'flux/**'],
      groupName: 'cluster-manifests',
    },
    {
      // The base env, the coding-agent CLIs and ACP adapters, the code-server
      // extension: co-dependent pins (jupyterlab and jupyter_server) bump together.
      matchFileNames: ['docker/purdue-af/**', 'pixi/base/**'],
      groupName: 'af-image',
    },
    {
      matchFileNames: ['docker/agentic-interface/**'],
      groupName: 'agentic-interface-image',
    },
    {
      matchFileNames: ['docker/agentic-analysis/**'],
      groupName: 'agentic-analysis-image',
    },
    {
      matchFileNames: ['docker/ray-nrp/**'],
      groupName: 'ray-nrp-image',
    },
    {
      matchFileNames: ['docker/af-node-monitor/**'],
      groupName: 'af-node-monitor-image',
    },
    {
      matchFileNames: ['docker/af-pod-monitor/**'],
      groupName: 'af-pod-monitor-image',
    },
    {
      matchFileNames: ['docker/supersonic-model-manager/**'],
      groupName: 'supersonic-model-manager-image',
    },
    {
      matchFileNames: ['docker/interlink-slurm-plugin/**'],
      groupName: 'interlink-slurm-plugin-image',
    },
    {
      matchFileNames: ['pixi/global/**'],
      groupName: 'pixi-global',
    },
    {
      matchFileNames: ['tests/integration_challenge/**'],
      groupName: 'integration-challenge',
    },
    {
      // Renovate cannot put lock file maintenance on another group's branch.
      matchUpdateTypes: ['lockFileMaintenance'],
      groupName: 'uv-lockfiles',
    },
    {
      // Merged by hand: pixi-global-sync installs with the released image's
      // pixi, which cannot read a lock in a format a newer pixi writes.
      matchPackageNames: ['prefix-dev/pixi'],
      automerge: false,
    },
    {
      // Merged by hand: no CI check runs the agentic-analysis runner and plugin on OpenCode.
      matchFileNames: ['docker/agentic-analysis/**'],
      matchPackageNames: ['opencode-ai'],
      automerge: false,
    },
    {
      matchManagers: ['flux'],
      addLabels: ['helm'],
    },
    {
      // Major chart/image bumps: extra label so they stand out.
      matchUpdateTypes: ['major'],
      addLabels: ['major'],
    },
    {
      // check-manifests renders with the runner's Helm: 24.04 has Helm 3, as the cluster's Flux does; 26.04 has Helm 4.
      matchDatasources: ['github-runners'],
      matchPackageNames: ['ubuntu'],
      allowedVersions: '/^2[024]\\.04$/',
    },
    {
      // KubeRay's chart is indexed days before quay.io/kuberay/operator has its image.
      matchManagers: ['flux'],
      matchPackageNames: ['kuberay-operator'],
      minimumReleaseAge: '7 days',
    },
    {
      // dask-gateway >=2025.4.0 requires kubeVersion >=1.30: hold until KUBE_VERSION reaches it.
      matchManagers: ['flux'],
      matchPackageNames: ['dask-gateway'],
      allowedVersions: '<2025.4.0',
    },
    {
      // Chart >=42 requires kubeVersion >=1.30: hold until KUBE_VERSION reaches it.
      // Its package name is the OCI path, and docker versioning has no ranges: use a regex.
      matchManagers: ['flux'],
      matchPackageNames: ['ghcr.io/traefik/helm/traefik'],
      allowedVersions: '/^41\\./',
    },
    {
      // Geddes GPU nodes run driver R580, which 26.07 fails on: 26.06+ is CUDA 13.3.x, paired
      // with driver >=610.43.02. fastml/triton-torchgeo is this Triton, tagged <version>-py3-geometric.
      matchDatasources: ['docker'],
      matchPackageNames: [
        'nvcr.io/nvidia/tritonserver',
        'fastml/triton-torchgeo',
      ],
      allowedVersions: '/^26\\.04/',
    },
    {
      // A path on CVMFS, not a registry: no tag lookup applies.
      matchDatasources: ['docker'],
      matchPackageNames: ['/cvmfs/**'],
      enabled: false,
    },
    {
      // The dask-gateway images move with the chart held above.
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/dask/dask-gateway', 'ghcr.io/dask/dask-gateway-server'],
      allowedVersions: '/^2024\\.1\\./',
    },
    {
      // dask-gateway's proxy, on every client-to-scheduler connection: merged by
      // hand. Traefik 3 needs the CRDs and RBAC of chart >=2025.4.0.
      matchFileNames: ['apps/dask-gateway/**'],
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/library/traefik'],
      allowedVersions: '/^2\\./',
      automerge: false,
    },
    {
      // The Flyte object store; its RELEASE.<UTC timestamp> tags are not docker versions.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/pgsty/silo'],
      versioning: 'regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T\\d{2}-\\d{2}-\\d{2}Z$',
    },
    {
      // The Ray Train clusters, their gateway and the pre-pulled copy: one
      // version in every file, merged by hand.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/rayproject/ray'],
      automerge: false,
    },
    {
      // The AF image base, merged by hand: a CUDA minor is a GPU re-test.
      // CUDA 13.3 pairs with driver >=610.43.02; Geddes runs R580 (see Triton above).
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/nvidia/cuda'],
      allowedVersions: '/^12\\./',
      automerge: false,
    },
    {
      // A PostgreSQL major needs a dump and restore, not a tag bump. Merged by hand:
      // a bump restarts flyte-postgres under any Flyte run in progress.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/library/postgres'],
      allowedVersions: '/^16([.-]|$)/',
      groupName: 'flyte-postgres',
      automerge: false,
    },
    {
      // krab's PostgreSQL holds its PVC on 18: the same major hold, in its own group.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/library/postgres'],
      matchFileNames: ['apps/krab/**'],
      allowedVersions: '/^18([.-]|$)/',
      groupName: 'krab-postgres',
    },
    {
      // ServiceX's PostgreSQL and RabbitMQ: versions belong to the chart's
      // subcharts, and this catalog is frozen upstream.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/bitnamilegacy/**'],
      enabled: false,
    },
    {
      // Renovate proposes only kubectl within one minor of KUBE_VERSION, its supported skew.
      matchPackageNames: ['kubernetes/kubernetes'],
      allowedVersions: '/^v1\\.(28|29|30)\\.\\d+$/',
    },
    {
      // This image publishes no tag within that skew, so the Jobs stay on their minor.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/alpine/kubectl'],
      allowedVersions: '/^1\\.34\\.\\d+$/',
    },
    {
      // The interlink-slurm-plugin base stays on Rocky 8 with RCAC's EL8 Slurm RPMs. Relax
      // when RCAC ships EL9+ RPMs, moving the Dockerfile, EPEL and the RPM glob together.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/rockylinux/rockylinux'],
      allowedVersions: '/^8([.-]|$)/',
    },
    {
      // Manifest-only: ci-pixi-*.yml regenerates pixi.lock and commits it to the PR,
      // since `pixi lock` on the science stack OOMs Mend runners.
      matchManagers: ['pixi'],
      skipArtifactsUpdate: true,
      addLabels: ['pixi'],
    },
    {
      // Stable releases only. A later allowedVersions replaces this; use a regex.
      matchFileNames: ['pixi/base/pixi.toml', 'pixi/global/pixi.toml'],
      allowedVersions: '!/(a|b|rc)\\d*$/',
    },
    {
      // openssh's portable versions (9.8p1, all stable) are not pep440; without
      // this the pixi manager cannot parse them and proposes nothing.
      matchPackageNames: ['openssh'],
      matchDatasources: ['conda'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)p(?<patch>\\d+)$',
    },
    {
      // Every conda-forge code-server build pins nodejs >=22,<23. Relax if code-server moves off it.
      matchPackageNames: ['nodejs'],
      matchFileNames: ['pixi/base/pixi.toml'],
      allowedVersions: '<23',
    },
    {
      // 6.0 moves the Python bindings to `python-xrootd`, which rucio-clients and fsspec-xrootd need.
      // To lift: move both pixi manifests, add `python-xrootd`, confirm `import XRootD` and fsspec-xrootd.
      matchPackageNames: ['xrootd'],
      matchDatasources: ['conda'],
      allowedVersions: '<6',
    },
    {
      // Python stays at 3.12 outside pixi/global. pixi/base's minor is also baked into the AF
      // Dockerfile's site-packages path and the hub's sitecustomize.py mountPath: raise them together.
      matchPackageNames: ['python', 'docker.io/library/python'],
      matchDatasources: ['docker', 'conda'],
      allowedVersions: '/^3\\.12([.-]|$)/',
    },
    {
      // pixi/global takes 3.13: roastcoffea requires python <3.14. Stays after the 3.12 rule.
      matchPackageNames: ['python'],
      matchFileNames: ['pixi/global/pixi.toml'],
      allowedVersions: '/^3\\.1[23]\\.\\d+$/',
    },
    {
      // servicex needs aioboto3, whose every release pins an aiobotocore 2.x
      // that requires wrapt <2. Relax once aioboto3 moves to aiobotocore 3.
      matchPackageNames: ['wrapt'],
      matchFileNames: ['pixi/global/pixi.toml'],
      allowedVersions: '/^1\\./',
    },
    {
      // The bokeh cap in pixi/global/pixi.toml, which Renovate reads as an
      // ordinary range and would raise. Relax with that cap.
      matchPackageNames: ['bokeh'],
      matchFileNames: ['pixi/global/pixi.toml'],
      allowedVersions: '/^3\\.9\\.\\d+$/',
    },
    {
      // The Intel Mac cap in the mypy hook. Relax when no dev Python runs under Rosetta.
      matchPackageNames: ['cryptography'],
      matchFileNames: ['.pre-commit-config.yaml'],
      enabled: false,
    },
  ],
}
