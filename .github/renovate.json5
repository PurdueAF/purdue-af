// Renovate configuration — automated dependency update PRs.
//
// Activation: install the Mend Renovate GitHub App on this repository
// (https://github.com/apps/renovate). The app reads this file from main.
//
// Cluster Kubernetes version: 1.29.x (Geddes). When upgrading the cluster,
// review Helm chart kubeVersion constraints before relaxing packageRules below.
//
// Covers:
//   - Flux HelmRelease chart versions (apps/**) via the flux manager
//   - Dockerfile base images (FROM tags)
//   - GitHub Actions versions (+ pins them to commit SHAs)
//   - Python deps (docker/agentic-interface/pyproject.toml + uv.lock) via the uv manager
//   - pixi manifests (pixi/{base,global}/pixi.toml) — NOT lockfiles
//   - pre-commit hook versions
//   - regex managers: Dockerfile ARG pins (pixi CLI, coding-agent CLIs, ACP
//     adapters) and the integration-challenge revision
//
// Pixi lockfiles: Renovate only bumps pixi.toml. CI (ci-pixi-base.yml /
// ci-pixi-global.yml) regenerates pixi.lock when out of sync, runs check-env,
// and on success commits the lock back to the PR branch. That keeps Mend
// runners free of `pixi lock` (which OOMs / fills disk on the science stack)
// while still landing green PRs.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    // Pin `uses:` action refs to immutable commit SHAs (tag kept as comment).
    'helpers:pinGitHubActionDigests',
  ],
  // Batch update PRs into a weekly window to keep noise down.
  schedule: ['before 6am on monday'],
  timezone: 'America/Indiana/Indianapolis',
  labels: ['dependencies'],

  prConcurrentLimit: 2,
  branchConcurrentLimit: 2,

  // Automerge uses GitHub's native auto-merge, which waits on the ci-ok check
  // the main ruleset requires; without that ruleset Renovate merges itself.

  // ci-pixi-*.yml pushes the regenerated pixi.lock as this bot; without this
  // Renovate treats the branch as hand-edited and never merges it.
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],

  // Empty, not absent: `config:recommended` pulls in `:ignoreModulesAndTests`,
  // which skips `**/tests/**` — where the integration-challenge pin and the
  // test suite's own dependencies live.
  ignorePaths: [],

  // Flux manager is opt-in by path: parse everything Flux reconciles.
  flux: {
    managerFilePatterns: ['/(^|/)apps/.*\\.ya?ml$/', '/(^|/)deploy/.*\\.ya?ml$/'],
  },

  'pre-commit': {
    enabled: true,
  },

  // The pixi CLI pin; ci-pixi-*.yml read it from the Dockerfile at run time.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG PIXI_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'prefix-dev/pixi',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // Coding-agent CLIs baked into the AF image. Pinned as Dockerfile ARGs
      // (npm install -g <pkg>@<version>), so only a regex manager sees them.
      // The matching code-server extensions are pinned in
      // docker/purdue-af/scripts/config-extensions.sh and come from Open VSX,
      // which Renovate cannot query — bump those by hand alongside these.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: [
        'ARG CLAUDE_CODE_VERSION="(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'npm',
      depNameTemplate: '@anthropic-ai/claude-code',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG CODEX_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@openai/codex',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG OPENCODE_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'opencode-ai',
    },
    {
      // ACP adapters — Claude and Codex again, reached from JupyterLab through
      // jupyter-ai instead of a terminal. Separate packages on their own
      // release cadences, so they get their own ARGs and their own managers.
      // opencode needs no adapter: jupyter-ai drives its binary directly.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG CLAUDE_AGENT_ACP_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@agentclientprotocol/claude-agent-acp',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/(^|/)Dockerfile$/'],
      matchStrings: ['ARG CODEX_ACP_VERSION="(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@zed-industries/codex-acp',
    },
    {
      // The IRIS-HEP integration challenge revision (tests/integration_challenge/upstream.pin).
      customType: 'regex',
      managerFilePatterns: ['/(^|/)upstream\\.pin$/', '/(^|/)workflows/integration-challenge/workflow\\.py$/'],
      matchStrings: ['ref=(?<currentDigest>[0-9a-f]{40})', 'IC_REF = "(?<currentDigest>[0-9a-f]{40})"'],
      currentValueTemplate: 'main',
      datasourceTemplate: 'git-refs',
      depNameTemplate: 'https://github.com/iris-hep/integration-challenge',
    },
  ],

  packageRules: [
    {
      // Private cluster registry — Renovate has no credentials for it and the
      // images are built in-repo anyway (CI builds).
      matchDatasources: ['docker'],
      matchPackageNames: ['geddes-registry.rcac.purdue.edu/**'],
      enabled: false,
    },
    {
      matchUpdateTypes: ['minor', 'patch', 'digest', 'pin', 'pinDigest'],
      automerge: true,
    },
    {
      // Merged by hand: pixi-global-sync installs with the released image's
      // pixi, which cannot read a lock in a format a newer pixi writes.
      matchPackageNames: ['prefix-dev/pixi'],
      automerge: false,
    },
    {
      // Group all GitHub Actions bumps into one PR.
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
    },
    {
      // One PR for the coding-agent CLIs and ACP adapters: each changes the
      // AF image's input hash, so separate PRs rebuild the image after every merge.
      matchPackageNames: [
        '@anthropic-ai/claude-code',
        '@openai/codex',
        'opencode-ai',
        '@agentclientprotocol/claude-agent-acp',
        '@zed-industries/codex-acp',
      ],
      groupName: 'coding agents',
    },
    {
      // Helm chart bumps stay individual PRs, labelled for triage.
      matchManagers: ['flux'],
      addLabels: ['helm'],
    },
    {
      // Major chart/image bumps: extra label so they stand out.
      matchUpdateTypes: ['major'],
      addLabels: ['major'],
    },
    {
      // KubeRay's chart is indexed days before quay.io/kuberay/operator has its image.
      matchManagers: ['flux'],
      matchPackageNames: ['kuberay-operator'],
      minimumReleaseAge: '7 days',
    },
    {
      // dask-gateway >=2025.4.0 requires kubeVersion >=1.30; cluster is on
      // 1.29. Hold at 2024.1.0 until the cluster is upgraded to 1.30+.
      matchManagers: ['flux'],
      matchPackageNames: ['dask-gateway'],
      allowedVersions: '<2025.4.0',
    },
    {
      // Hold Triton at 26.04 for Geddes GPU nodes on NVIDIA driver R580.
      // 26.06+ is CUDA 13.3.x, whose paired Linux driver is >=610.43.02
      // (CUDA Toolkit release notes Table 3). CUDA 13.x MVC lists >=580 as
      // the floor, but 26.07 fails on R580. The host NVIDIA driver is not a
      // Renovate-tracked dep in this repo.
      // docker versioning has no range support — use a regex pin.
      // fastml/triton-torchgeo is the same Triton with extra backends
      // (apps/sonic/supersonic), tagged <triton version>-py3-geometric, so the
      // same driver constraint and the same regex hold for it.
      matchDatasources: ['docker'],
      matchPackageNames: [
        'nvcr.io/nvidia/tritonserver',
        'fastml/triton-torchgeo',
      ],
      allowedVersions: '/^26\\.04/',
    },
    {
      // interlink-slurm-plugin base must stay on Rocky 8: site clients are
      // slurm-*-1.el8.x86_64.rpm, the Dockerfile installs EPEL 8, and RCAC
      // Slurm itself runs on EL8. A jump to Rocky 10 (Renovate dashboard)
      // would break the dnf/EPEL layer and mismatch the relocated clients.
      // Relax only when RCAC ships EL9/EL10 Slurm RPMs and the sidecar is
      // retargeted (Dockerfile + epel + rpm glob together).
      // docker versioning has no range support — use a regex pin.
      matchDatasources: ['docker'],
      matchPackageNames: ['docker.io/rockylinux/rockylinux', 'rockylinux/rockylinux'],
      allowedVersions: '/^8([.-]|$)/',
    },
    {
      // Manifest-only: CI regenerates pixi.lock (see ci-pixi-*.yml). Skipping
      // artifacts here is what keeps Mend runners from running `pixi lock`.
      matchManagers: ['pixi'],
      skipArtifactsUpdate: true,
      addLabels: ['pixi'],
    },
    {
      // One PR for the AF base env so co-dependent pins bump together
      // (e.g. jupyterlab needing a matching jupyter_server).
      matchManagers: ['pixi'],
      matchFileNames: ['pixi/base/**'],
      groupName: 'pixi-base',
    },
    {
      matchManagers: ['pixi'],
      matchFileNames: ['pixi/global/**'],
      groupName: 'pixi-global',
    },
    {
      // Stable releases only — no a/b/rc.
      matchFileNames: ['pixi/base/pixi.toml', 'pixi/global/pixi.toml'],
      allowedVersions: '!/(a|b|rc)\\d*$/',
    },
    {
      // openssh uses upstream's "portable" versioning (9.8p1, 10.4p1 — all
      // STABLE releases; pN is the portable-line number, not a pre-release).
      // That's not valid pep440, so without this rule the pixi manager can't
      // parse it and silently never proposes openssh updates. Map the scheme
      // so openssh is Renovate-managed like everything else.
      matchPackageNames: ['openssh'],
      matchDatasources: ['conda'],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)p(?<patch>\\d+)$',
    },
    {
      // code-server has never supported nodejs >=23 (every conda-forge build
      // pins nodejs >=22,<23) — a nodejs major bump can never solve together
      // with code-server. Blocks the doomed proposal.
      // Relax if code-server upstream ever moves off the 22.x pin.
      matchPackageNames: ['nodejs'],
      matchFileNames: ['pixi/base/pixi.toml'],
      allowedVersions: '<23',
    },
    {
      // xrootd is capped below 6.x in BOTH pixi manifests. The 6.0
      // packaging split moved the Python bindings out of the `xrootd` package
      // into `python-xrootd`: conda-forge ships no py312 build of `xrootd` 6.x
      // at all, so an automated bump would silently drop the `XRootD` module
      // that rucio-clients and fsspec-xrootd import, while xrdcp kept working.
      // 6.0 also breaks callers: glob/iglob default to raise_error=true,
      // `xrdcp --allow-http` is gone, the Davix XrdClHttp plugin is removed,
      // and XrdEc is deprecated.
      // 5.9.x is NOT stale — it is maintained in parallel with 6.x (5.9.6 and
      // 6.1.0 shipped the same day), so patch bumps stay allowed.
      // To lift: move pixi/base AND pixi/global together, add `python-xrootd`
      // explicitly, and confirm `import XRootD` plus fsspec-xrootd still work
      // (pixi/check-env.py gates the import).
      matchPackageNames: ['xrootd', 'python-xrootd', 'libxrootd'],
      matchDatasources: ['conda'],
      allowedVersions: '<6',
    },
    {
      // Python stays at 3.12 everywhere but pixi/global (next rule): the
      // docker manager (FROM python:3.12-slim) and the other pixi manifests.
      // pixi/base's minor is also baked into the AF Dockerfile's
      // site-packages path and the hub's sitecustomize.py mountPath, which
      // Renovate cannot update, so raise them by hand in one change.
      // 3.12.x patch releases stay allowed.
      // Regex (not '<3.13'): docker versioning has no range support, and this
      // rule also matches the docker datasource (FROM python:3.12-slim).
      matchPackageNames: ['python'],
      matchDatasources: ['docker', 'conda'],
      allowedVersions: '/^3\\.12([.-]|$)/',
    },
    {
      // pixi/global takes Python 3.13; 3.14 does not solve yet: cms-combine's
      // py3.14 builds hit the giflib conflict (next rule), and roastcoffea
      // requires python <3.14. Overrides the rule above, so it stays after it.
      // Regex, not '<3.14': this allowedVersions replaces the stable-only one
      // above, and a range admits 3.14 release candidates.
      matchPackageNames: ['python'],
      matchFileNames: ['pixi/global/pixi.toml'],
      allowedVersions: '/^3\\.1[23]\\.\\d+$/',
    },
    {
      // cms-combine 11.1.0 needs root_base >=6.36.14, whose every build links
      // giflib 6; imagemagick (via hepdata-lib) has only giflib-5 builds.
      // Relax once conda-forge publishes an imagemagick built against giflib 6.
      // Regex: this allowedVersions replaces the stable-only one above.
      matchPackageNames: ['cms-combine'],
      matchFileNames: ['pixi/global/pixi.toml'],
      allowedVersions: '/^11\\.0\\.\\d+$/',
    },
    {
      // servicex needs aioboto3, whose every release pins an aiobotocore 2.x
      // that requires wrapt <2. Relax once aioboto3 moves to aiobotocore 3.
      // Regex: this allowedVersions replaces the stable-only one above.
      matchPackageNames: ['wrapt'],
      matchFileNames: ['pixi/global/pixi.toml'],
      allowedVersions: '/^1\\./',
    },
  ],
}
